{
  "expo": {
    "name": "face-sim",
    "slug": "face-sim",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "facesim",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "com.example.facesim",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e593dc2-9b66-44b2-b6b9-c8658b6a18ae"
      }
    }
  }
}